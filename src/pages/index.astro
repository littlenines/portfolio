---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Hero from '@components/hero/Hero.astro';
import Projects from '@components/sections/Projects.astro';
import Stack from '@components/sections/Stack.astro';
import Contact from '@components/sections/Contact.astro';
import SkipLink from '@components/ui/SkipLink.astro';
import Loader from '@components/effects/Loader.astro';
import WarnBar from '@components/effects/WarnBar.astro';
import BackToTop from '@components/effects/BackToTop.astro';
import Toast from '@components/effects/Toast.astro';
import ThemeVeil from '@components/effects/ThemeVeil.astro';
import Reticle from '@components/effects/Reticle.astro';
import NightField from '@components/effects/NightField.astro';
---

<Layout themed>
  <Loader />
  <div class="page" id="top" tabindex="-1" data-back-to-top-target>
    <SkipLink />
    <Header />
    <Hero />
    <WarnBar />
    <main class="container" id="main" tabindex="-1">
      <Projects />
      <Stack />
      <Contact />
    </main>
    <Footer />
  </div>

  <!-- Fixed overlays stay direct children of body so no parent stacking context traps them -->
  <BackToTop />
  <Toast />
  <ThemeVeil />
  <Reticle />
  <NightField />
</Layout>
