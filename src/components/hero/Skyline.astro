---
import StreamBeams from '@components/hero/StreamBeams.astro';
import { PALETTE } from '@lib/palette';
import { buildSkyline, type Haze } from '@lib/skyline';
import type { WindowLight } from '@lib/skyline-windows';
import { SKYLINE_VARIANTS, type SkylineVariant } from '@lib/skyline-variants';
import { buildStreamBeams } from '@lib/stream-beams';

interface Props {
  variant?: SkylineVariant;
}

const { variant = 'home' } = Astro.props;

const HAZE_ID = 'skyline-haze';
const HAZE_COLOR = PALETTE.peach;
const HAZE_OPACITY = 0.26;
const ACCENT_COLOR = PALETTE.pink;
const BEACON_RADIUS = 2.5;
const NEON_OPACITY = 0.55;

const options = SKYLINE_VARIANTS[variant];
const skyline = buildSkyline(options);
const viewBox = `0 0 ${skyline.width} ${skyline.height}`;
const frontTowers = skyline.layers.at(-1)?.towers ?? [];
const streamBeams = options.streamBeams ? buildStreamBeams(frontTowers, skyline.width, skyline.height) : [];
const hasHaze = skyline.layers.some((layer) => layer.haze);
const { width: windowWidth, height: windowHeight } = skyline.windowSize;

const hazeEllipses = ({ centers, cy, rx, ry }: Haze) => centers.map((cx) => ({ cx, cy, rx, ry }));

const windowClasses = (light: WindowLight) => [
  'skyline__window',
  { 'skyline__window--after-dark': light.afterDark, 'skyline__window--flicker': light.flickerDelay !== undefined },
];

const windowStyle = (light: WindowLight) =>
  [
    light.switchDelay !== undefined && `transition-delay:${light.switchDelay}s`,
    light.flickerDelay !== undefined && `animation-delay:${light.flickerDelay}s`,
  ]
    .filter(Boolean)
    .join(';') || undefined;
---

<div class="skyline">
  <svg viewBox={viewBox} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    {hasHaze && (
      <defs>
        <radialGradient id={HAZE_ID}>
          <stop offset="0" stop-color={HAZE_COLOR} stop-opacity={HAZE_OPACITY} />
          <stop offset="1" stop-color={HAZE_COLOR} stop-opacity="0" />
        </radialGradient>
      </defs>
    )}
    {skyline.layers.map((layer) => (
      <>
        <g fill={layer.color} opacity={layer.opacity}>
          {layer.shapes.map((shape) => (
            <rect x={shape.x} y={shape.y} width={shape.width} height={shape.height} />
          ))}
        </g>
        {[
          { lights: layer.lit, group: 'skyline__lit' },
          { lights: layer.awake, group: 'skyline__awake' },
        ].map(
          ({ lights, group }) =>
            lights.length > 0 && (
              <g class={group} fill={skyline.windowColor}>
                {lights.map((light) => (
                  <rect
                    class:list={windowClasses(light)}
                    x={light.x}
                    y={light.y}
                    width={windowWidth}
                    height={windowHeight}
                    opacity={light.opacity}
                    style={windowStyle(light)}
                  />
                ))}
              </g>
            ),
        )}
        {layer.beacons.map((beacon) => (
          <circle class="skyline__beacon" cx={beacon.cx} cy={beacon.cy} r={BEACON_RADIUS} fill={ACCENT_COLOR} />
        ))}
        {layer.neon.map((sign) => (
          <rect
            class="skyline__neon"
            x={sign.x}
            y={sign.y}
            width={sign.width}
            height={sign.height}
            fill={ACCENT_COLOR}
            opacity={NEON_OPACITY}
          />
        ))}
        {layer.haze && (
          <g class="skyline__haze">
            {hazeEllipses(layer.haze).map((ellipse) => (
              <ellipse {...ellipse} fill={`url(#${HAZE_ID})`} />
            ))}
          </g>
        )}
      </>
    ))}
  </svg>

  {streamBeams.length > 0 && <StreamBeams beams={streamBeams} viewBox={viewBox} />}
</div>
