---
import { hexagonCorners } from '@lib/geometry';
import { ICON_CENTER } from './icon-frame';

const RADIUS = 7;
const LABEL_SIZE = 6.5;
const UNIT_NUMBER = '01';
const COORDINATE_DECIMALS = 2;

const points = hexagonCorners(ICON_CENTER, RADIUS)
  .map(({ x, y }) => `${x.toFixed(COORDINATE_DECIMALS)},${y.toFixed(COORDINATE_DECIMALS)}`)
  .join(' ');
---

<polygon class="theme-icon__hexagon" points={points} />
<text class="theme-icon__unit-number" x={ICON_CENTER.x} y={ICON_CENTER.y} font-size={LABEL_SIZE}>
  {UNIT_NUMBER}
</text>
