---
import Section from '@components/layout/Section.astro';
import Button from '@components/ui/Button.astro';
import ThemedText from '@components/ui/ThemedText.astro';
import { site } from '@data/site';
---

<Section id="contact" index="03" japanese="連絡" label="contact">
  <div class="contact" data-reveal>
    <h3 class="contact__title">
      <ThemedText>
        Got a gig? Let's talk.
        <Fragment slot="evangelion">Got a mission? Let's talk.</Fragment>
      </ThemedText>
    </h3>

    <div class="contact__mail-row">
      <a class="contact__mail mono" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <button
        class="pill-btn mono"
        type="button"
        aria-label="Copy email address"
        data-copy={site.email}
        data-copied-message="Email copied"
      >
        copy
      </button>
    </div>

    <div class="btn-group">
      {site.socials.map((social) => (
        <Button href={social.href} external aria-label={`${social.label} profile (opens in new tab)`}>
          {social.label}
        </Button>
      ))}
    </div>

    {/* TODO: Uncomment this - i hate making a CV */}
    {/* <a class="contact__cv mono" href={site.cv} download aria-label="Download CV as PDF">↓ download cv</a> */}
  </div>
</Section>

<script>
  import { initCopyButtons } from '@scripts/effects/copy-text';

  initCopyButtons();
</script>
