<div class="theme-veil" aria-hidden="true" data-theme-veil>
  <div class="theme-veil__alert">
    <div class="theme-veil__tape theme-veil__tape--top"></div>
    <div class="theme-veil__tape theme-veil__tape--bottom"></div>
    <div class="theme-veil__count" data-veil-count></div>
    <div class="theme-veil__warning">警告</div>
    <div class="theme-veil__subtitle">WARNING // SYNCHRONISING</div>
    <div class="theme-veil__panel">
      <span>SYNC RATE</span>
      <b class="theme-veil__rate" data-veil-rate></b>
    </div>
  </div>
  <div class="theme-veil__card">
    <div class="theme-veil__title" data-veil-title></div>
    <div class="theme-veil__caption" data-veil-caption></div>
  </div>
</div>
