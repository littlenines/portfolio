---
import { BOOT_TIMEOUT_MS } from '@scripts/lib/boot';
import { MEDIA } from '@scripts/lib/media';
import { STATE_CLASS } from '@scripts/lib/state-classes';
import { RETURNING_NAVIGATIONS } from '@scripts/loader';
---

<!-- Skips the loader when coming back to the page, and unlocks scrolling even if the loader script never runs -->
<script
  is:inline
  define:vars={{
    timeout: BOOT_TIMEOUT_MS,
    loadingClass: STATE_CLASS.loading,
    reducedMotion: MEDIA.reducedMotion,
    returningNavigations: RETURNING_NAVIGATIONS,
  }}
>
  const [navigation] = performance.getEntriesByType('navigation');
  const isReturning = navigation !== undefined && returningNavigations.includes(navigation.type);

  if (!isReturning && !matchMedia(reducedMotion).matches) {
    const root = document.documentElement;

    root.classList.add(loadingClass);
    setTimeout(() => root.classList.remove(loadingClass), timeout);
  }
</script>

<div class="loader mono" role="status" aria-label="Loading" data-loader>
  <div class="loader__log" aria-hidden="true" data-loader-log></div>
  <div class="loader__bar" aria-hidden="true">
    <i class="loader__progress" data-loader-progress></i>
  </div>
</div>

<script>
  import { initLoader } from '@scripts/loader';

  void initLoader();
</script>
